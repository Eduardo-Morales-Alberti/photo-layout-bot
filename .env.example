# Required: token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Optional layout tuning (defaults shown)
DPI=300
MAX_LONG_CM=16
MAX_SHORT_CM=13
# Images may shrink down to this min box to fit more per page (set equal to
# the MAX values to disable shrinking and always use the max size).
# MIN_SHORT_CM is also enforced per photo, so long, narrow photos (16:9) are
# not shrunk below it.
MIN_LONG_CM=12
MIN_SHORT_CM=9
MARGIN_CM=0
GAP_CM=0
ALLOW_UPSCALE=true
ALLOW_ROTATE=true
# Grow a page's images to fill leftover space (never beyond the max box)
FILL_PAGE=true

# Output: PDF (one multi-page PDF, recommended), PNG or JPEG (one file per page)
OUT_FORMAT=PDF
# JPEG quality; for PDF it is the starting quality, lowered only if needed
JPEG_QUALITY=95

# PDF size limit. Bots can upload at most 50 MB. To stay under it the bot
# lowers the JPEG quality (down to MIN_JPEG_QUALITY), then the DPI (down to
# MIN_DPI), and only then splits the batch into several PDFs.
MAX_PDF_MB=45
MIN_JPEG_QUALITY=75
MIN_DPI=200

# Warn when an image would print below this resolution
LOW_DPI_WARNING=150

# If the last page has room for more photos, keep its photos queued and ask
# whether to generate it now or wait for more photos
HOLD_PARTIAL_PAGE=true

# Seconds to wait after the last photo before the "N images" acknowledgement
DEBOUNCE_SECONDS=1.5
